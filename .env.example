# Cloud provider (OpenAI-compatible). Leave AI_API_KEY empty to try local Ollama.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Local Ollama provider
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Local app settings
DATABASE_PATH=./your_ai.db
APP_NAME=Your AI
